{
  "info": {
    "name": "E2E - Compensation: Refund (Out of Stock After Payment)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "COMPENSATION FLOW: Order 1 reserves most stock → Order 2 gets OUT_OF_STOCK → Order 1 pays and completes. Tests stock exhaustion scenario."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('test_email') || pm.environment.get('test_email') === '') {",
          "    const uniqueEmail = 'e2e_refund_' + Date.now() + '@testmail.com';",
          "    pm.environment.set('test_email', uniqueEmail);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Register User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registration successful', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"{{test_name}}\",\n    \"email\": \"{{test_email}}\",\n    \"phoneNumber\": \"+6281234567893\",\n    \"password\": \"{{test_password}}\",\n    \"confirmPassword\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/auth/register",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "auth", "register"]
        }
      }
    },
    {
      "name": "2. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login successful', function() {",
              "    pm.response.to.have.status(200);",
              "    const response = pm.response.json();",
              "    pm.environment.set('access_token', response.access_token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{test_email}}\",\n    \"password\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "3. Create Order (use Webcam - qty 60, order 55 to leave only 5)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.environment.set('idempotency_key', pm.variables.replaceIn('{{$guid}}'));"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order 1 created', function() { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const response = pm.response.json();",
              "pm.environment.set('transaction_id_1', response.transactionId);",
              "console.log('┌─────────────────────────────────────');",
              "console.log('│ 📦 ORDER #1 CREATED (qty=55, Webcam HD)');",
              "console.log('│ transactionId: ' + response.transactionId);",
              "console.log('└─────────────────────────────────────');"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Idempotency-Key", "value": "{{idempotency_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"discountCode\": \"\",\n    \"items\": [\n        {\n            \"productId\": \"e5f6a7b8-c9d0-1234-efab-345678901234\",\n            \"quantity\": 55\n        }\n    ]\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders"]
        }
      }
    },
    {
      "name": "4. Poll Order 1 (WAITING_PAYMENT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "const status = response.orderStatus || response.status;",
              "console.log('│ 📋 Order 1: ' + status + ' | transactionId: ' + response.transactionId + ' | correlationId: ' + response.correlationId);",
              "if (status === 'PENDING') {",
              "    let r = pm.environment.get('retry_r1') || 0; r++;",
              "    if (r < 5) { pm.environment.set('retry_r1', r); setTimeout(function(){},2000); postman.setNextRequest('4. Poll Order 1 (WAITING_PAYMENT)'); }",
              "    else { pm.environment.unset('retry_r1'); pm.test('WAITING_PAYMENT', function(){ pm.expect(status).to.equal('WAITING_PAYMENT'); }); }",
              "} else { pm.environment.unset('retry_r1'); pm.test('Order 1 WAITING_PAYMENT', function(){ pm.expect(status).to.equal('WAITING_PAYMENT'); }); }"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders/status/{{transaction_id_1}}",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders", "status", "{{transaction_id_1}}"]
        }
      }
    },
    {
      "name": "5. Create Order 2 (same product, qty 10 - will exceed remaining)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.environment.set('idempotency_key_2', pm.variables.replaceIn('{{$guid}}'));"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order 2 created', function() { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const response = pm.response.json();",
              "pm.environment.set('transaction_id_2', response.transactionId);",
              "console.log('┌─────────────────────────────────────');",
              "console.log('│ 📦 ORDER #2 CREATED (qty=10, same product — should fail)');",
              "console.log('│ transactionId: ' + response.transactionId);",
              "console.log('└─────────────────────────────────────');"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Idempotency-Key", "value": "{{idempotency_key_2}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"discountCode\": \"\",\n    \"items\": [\n        {\n            \"productId\": \"e5f6a7b8-c9d0-1234-efab-345678901234\",\n            \"quantity\": 10\n        }\n    ]\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders"]
        }
      }
    },
    {
      "name": "6. Poll Order 2 (should be OUT_OF_STOCK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "const status = response.orderStatus || response.status;",
              "console.log('│ 📋 Order 2: ' + status + ' | transactionId: ' + pm.environment.get('transaction_id_2'));",
              "if (status === 'PENDING') {",
              "    let r = pm.environment.get('retry_r2') || 0; r++;",
              "    if (r < 5) { pm.environment.set('retry_r2', r); setTimeout(function(){},2000); postman.setNextRequest('6. Poll Order 2 (should be OUT_OF_STOCK)'); }",
              "    else { pm.environment.unset('retry_r2'); pm.test('OUT_OF_STOCK', function(){ pm.expect(status).to.equal('OUT_OF_STOCK'); }); }",
              "} else { pm.environment.unset('retry_r2'); pm.test('✅ Order 2 is OUT_OF_STOCK', function(){ pm.expect(status).to.equal('OUT_OF_STOCK'); }); }"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders/status/{{transaction_id_2}}",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders", "status", "{{transaction_id_2}}"]
        }
      }
    },
    {
      "name": "7. Complete Order 1 (pay + webhook)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.environment.set('pay_idem_1', pm.variables.replaceIn('{{$guid}}'));"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment for order 1 created', function() { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const response = pm.response.json();",
              "pm.environment.set('payment_id_1', response.paymentId);",
              "console.log('│ 💳 Payment created for Order 1 | paymentId: ' + response.paymentId + ' | transactionId: ' + response.transactionId);"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Idempotency-Key", "value": "{{pay_idem_1}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"transactionId\": \"{{transaction_id_1}}\",\n    \"paymentMethod\": \"CREDIT_CARD\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/payments",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "payments"]
        }
      }
    },
    {
      "name": "8. Webhook Success for Order 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Webhook accepted', function() { pm.expect(pm.response.code).to.be.oneOf([200, 202]); });",
              "console.log('│ 🔔 WEBHOOK: PAYMENT_SUCCESS | paymentId: ' + pm.environment.get('payment_id_1'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"paymentId\": \"{{payment_id_1}}\",\n    \"paymentStatus\": \"PAYMENT_SUCCESS\",\n    \"failureCode\": \"\",\n    \"failureMessage\": \"\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/payments/webhook/callback",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "payments", "webhook", "callback"]
        }
      }
    },
    {
      "name": "9. Verify Order 1 COMPLETED",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "const status = response.orderStatus || response.status;",
              "console.log('│ 📋 Order 1: ' + status + ' | transactionId: ' + response.transactionId + ' | correlationId: ' + response.correlationId);",
              "if (status !== 'COMPLETED') {",
              "    let r = pm.environment.get('retry_r3') || 0; r++;",
              "    if (r < 5) { pm.environment.set('retry_r3', r); setTimeout(function(){},2000); postman.setNextRequest('9. Verify Order 1 COMPLETED'); }",
              "    else { pm.environment.unset('retry_r3'); pm.test('COMPLETED', function(){ pm.expect(status).to.equal('COMPLETED'); }); }",
              "} else {",
              "    pm.environment.unset('retry_r3');",
              "    pm.test('✅ Order 1 COMPLETED', function(){ pm.expect(status).to.equal('COMPLETED'); });",
              "    console.log('┌─────────────────────────────────────');",
              "    console.log('│ 🎉 REFUND FLOW COMPLETED');",
              "    console.log('│ Order 1: ' + pm.environment.get('transaction_id_1') + ' → COMPLETED');",
              "    console.log('│ Order 2: ' + pm.environment.get('transaction_id_2') + ' → OUT_OF_STOCK');",
              "    console.log('│ paymentId: ' + pm.environment.get('payment_id_1'));",
              "    console.log('└─────────────────────────────────────');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders/status/{{transaction_id_1}}",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders", "status", "{{transaction_id_1}}"]
        }
      }
    }
  ]
}
