{
  "info": {
    "name": "E2E - Compensation: Out of Stock (No Payment)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "COMPENSATION FLOW: Order with quantity exceeding stock → saga FAILED → order OUT_OF_STOCK (no compensation needed since no payment)"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('test_email') || pm.environment.get('test_email') === '') {",
          "    const uniqueEmail = 'e2e_oos_' + Date.now() + '@testmail.com';",
          "    pm.environment.set('test_email', uniqueEmail);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Register User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registration successful', function() { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"{{test_name}}\",\n    \"email\": \"{{test_email}}\",\n    \"phoneNumber\": \"+6281234567891\",\n    \"password\": \"{{test_password}}\",\n    \"confirmPassword\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/auth/register",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "auth", "register"]
        }
      }
    },
    {
      "name": "2. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login successful', function() {",
              "    pm.response.to.have.status(200);",
              "    const r = pm.response.json();",
              "    pm.environment.set('access_token', r.access_token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{test_email}}\",\n    \"password\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "3. Create Order (Excessive Quantity)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.environment.set('idempotency_key', pm.variables.replaceIn('{{$guid}}'));"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order created', function() { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const response = pm.response.json();",
              "pm.environment.set('transaction_id', response.transactionId);",
              "console.log('┌─────────────────────────────────────');",
              "console.log('│ 📦 ORDER CREATED (qty=99999, expecting OUT_OF_STOCK)');",
              "console.log('│ transactionId: ' + response.transactionId);",
              "console.log('└─────────────────────────────────────');"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Idempotency-Key", "value": "{{idempotency_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"discountCode\": \"\",\n    \"items\": [\n        {\n            \"productId\": \"{{product_id}}\",\n            \"quantity\": 99999\n        }\n    ]\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders"]
        }
      }
    },
    {
      "name": "4. Poll Order Status (wait for OUT_OF_STOCK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order status retrieved', function() { pm.response.to.have.status(200); });",
              "",
              "const response = pm.response.json();",
              "const status = response.orderStatus;",
              "console.log('│ 📋 status: ' + status + ' | transactionId: ' + response.transactionId + ' | correlationId: ' + response.correlationId);",
              "",
              "if (status === 'PENDING') {",
              "    let retryCount = pm.environment.get('retry_count_oos') || 0;",
              "    retryCount++;",
              "    if (retryCount < 5) {",
              "        pm.environment.set('retry_count_oos', retryCount);",
              "        console.log('│ ⏳ Still PENDING, retrying... (' + retryCount + '/5)');",
              "        postman.setNextRequest('4. Poll Order Status (wait for OUT_OF_STOCK)');",
              "    } else {",
              "        pm.environment.unset('retry_count_oos');",
              "        pm.test('Order should be OUT_OF_STOCK', function() { pm.expect(status).to.equal('OUT_OF_STOCK'); });",
              "    }",
              "} else {",
              "    pm.environment.unset('retry_count_oos');",
              "    pm.test('✅ Order is OUT_OF_STOCK', function() { pm.expect(status).to.equal('OUT_OF_STOCK'); });",
              "    console.log('┌─────────────────────────────────────');",
              "    console.log('│ 🎉 OUT_OF_STOCK VERIFIED');",
              "    console.log('│ transactionId: ' + response.transactionId);",
              "    console.log('│ correlationId: ' + response.correlationId);",
              "    console.log('│ finalStatus:   ' + status);",
              "    console.log('└─────────────────────────────────────');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders/status/{{transaction_id}}",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders", "status", "{{transaction_id}}"]
        }
      }
    }
  ]
}
