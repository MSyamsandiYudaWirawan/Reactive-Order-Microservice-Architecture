{
  "info": {
    "name": "E2E - Compensation: Order Expiry (Never Paid → EXPIRED + Stock Released)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "COMPENSATION FLOW: Stock reserved but user never pays → orchestrator scheduler expires order (90s) and releases stock. Total wait: ~2min (90s expiry + 30s scheduler)"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('test_email') || pm.environment.get('test_email') === '') {",
          "    const uniqueEmail = 'e2e_expiry_' + Date.now() + '@testmail.com';",
          "    pm.environment.set('test_email', uniqueEmail);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('OK', function() { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"{{test_name}}\",\n    \"email\": \"{{test_email}}\",\n    \"phoneNumber\": \"+6281234567896\",\n    \"password\": \"{{test_password}}\",\n    \"confirmPassword\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/auth/register",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "auth", "register"]
        }
      }
    },
    {
      "name": "2. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login OK', function() {",
              "    pm.response.to.have.status(200);",
              "    pm.environment.set('access_token', pm.response.json().access_token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{test_email}}\",\n    \"password\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "3. Create Order (will never pay)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.environment.set('idempotency_key', pm.variables.replaceIn('{{$guid}}'));"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order created', function() { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const r = pm.response.json();",
              "pm.environment.set('transaction_id', r.transactionId);",
              "pm.environment.set('order_created_at', Date.now());",
              "console.log('┌─────────────────────────────────────');",
              "console.log('│ 📦 ORDER CREATED (will NOT pay)');",
              "console.log('│ transactionId: ' + r.transactionId);",
              "console.log('│ ⏱️ Waiting for scheduler expiry (~2 min)');",
              "console.log('└─────────────────────────────────────');"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Idempotency-Key", "value": "{{idempotency_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"discountCode\": \"\",\n    \"items\": [\n        {\n            \"productId\": \"{{product_id}}\",\n            \"quantity\": 1\n        }\n    ]\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders"]
        }
      }
    },
    {
      "name": "4. Confirm WAITING_PAYMENT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "const status = response.orderStatus;",
              "console.log('│ 📋 status: ' + status + ' | transactionId: ' + response.transactionId + ' | correlationId: ' + response.correlationId);",
              "if (status === 'PENDING') {",
              "    let r = pm.environment.get('retry_wp') || 0; r++;",
              "    if (r < 5) { pm.environment.set('retry_wp', r); postman.setNextRequest('4. Confirm WAITING_PAYMENT'); }",
              "    else { pm.environment.unset('retry_wp'); pm.test('WAITING_PAYMENT', function(){ pm.expect(status).to.equal('WAITING_PAYMENT'); }); }",
              "} else {",
              "    pm.environment.unset('retry_wp');",
              "    pm.environment.set('correlation_id', response.correlationId);",
              "    pm.test('Order is WAITING_PAYMENT', function(){ pm.expect(status).to.equal('WAITING_PAYMENT'); });",
              "    console.log('│ ✅ Stock reserved — correlationId: ' + response.correlationId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders/status/{{transaction_id}}",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders", "status", "{{transaction_id}}"]
        }
      }
    },
    {
      "name": "5. Wait for Expiry (poll every 15s)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status retrieved', function() { pm.response.to.have.status(200); });",
              "",
              "const response = pm.response.json();",
              "const status = response.orderStatus;",
              "const elapsed = Math.round((Date.now() - pm.environment.get('order_created_at')) / 1000);",
              "console.log('│ 📋 status: ' + status + ' | elapsed: ' + elapsed + 's | transactionId: ' + response.transactionId + ' | correlationId: ' + response.correlationId);",
              "",
              "if (status === 'EXPIRED') {",
              "    pm.environment.unset('retry_expiry');",
              "    pm.test('✅ Order EXPIRED by scheduler', function() { pm.expect(status).to.equal('EXPIRED'); });",
              "    console.log('┌─────────────────────────────────────');",
              "    console.log('│ 🎉 ORDER EXPIRED + STOCK RELEASED');",
              "    console.log('│ transactionId: ' + response.transactionId);",
              "    console.log('│ correlationId: ' + response.correlationId);",
              "    console.log('│ elapsed:       ' + elapsed + 's');",
              "    console.log('└─────────────────────────────────────');",
              "} else if (status === 'WAITING_PAYMENT') {",
              "    let retryCount = pm.environment.get('retry_expiry') || 0;",
              "    retryCount++;",
              "    if (retryCount < 10) {",
              "        pm.environment.set('retry_expiry', retryCount);",
              "        console.log('│ ⏳ retry ' + retryCount + '/10');",
              "        postman.setNextRequest('5. Wait for Expiry (poll every 15s)');",
              "    } else {",
              "        pm.environment.unset('retry_expiry');",
              "        pm.test('Order should have expired within 2.5 min', function() { pm.expect(status).to.equal('EXPIRED'); });",
              "    }",
              "} else {",
              "    let retryCount = pm.environment.get('retry_expiry') || 0;",
              "    retryCount++;",
              "    if (retryCount < 10) {",
              "        pm.environment.set('retry_expiry', retryCount);",
              "        console.log('⏳ Unexpected order status ' + status + ', retry ' + retryCount + '/10');",
              "        postman.setNextRequest('5. Wait for Expiry (poll every 15s)');",
              "    } else {",
              "        pm.environment.unset('retry_expiry');",
              "        pm.test('Order should have expired', function() { pm.expect(status).to.equal('EXPIRED'); });",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders/status/{{transaction_id}}",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders", "status", "{{transaction_id}}"]
        }
      }
    }
  ]
}
