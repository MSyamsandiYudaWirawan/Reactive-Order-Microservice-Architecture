{
  "info": {
    "name": "E2E - Compensation: Payment Expiry (No Webhook → Payment FAILED → Order EXPIRED)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "COMPENSATION FLOW: Create payment but never send webhook → payment-service scheduler expires payment (30s) → orchestrator scheduler expires order (90s). Total wait: ~2min"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('test_email') || pm.environment.get('test_email') === '') {",
          "    const uniqueEmail = 'e2e_payexp_' + Date.now() + '@testmail.com';",
          "    pm.environment.set('test_email', uniqueEmail);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('OK', function() { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"{{test_name}}\",\n    \"email\": \"{{test_email}}\",\n    \"phoneNumber\": \"+6281234567897\",\n    \"password\": \"{{test_password}}\",\n    \"confirmPassword\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/auth/register",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "auth", "register"]
        }
      }
    },
    {
      "name": "2. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login OK', function() {",
              "    pm.response.to.have.status(200);",
              "    const r = pm.response.json();",
              "    pm.environment.set('access_token', r.access_token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{test_email}}\",\n    \"password\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "3. Create Order",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.environment.set('idempotency_key', pm.variables.replaceIn('{{$guid}}'));"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order created', function() { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const r = pm.response.json();",
              "pm.environment.set('transaction_id', r.transactionId);",
              "console.log('┌─────────────────────────────────────');",
              "console.log('│ 📦 ORDER CREATED');",
              "console.log('│ transactionId: ' + r.transactionId);",
              "console.log('└─────────────────────────────────────');"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Idempotency-Key", "value": "{{idempotency_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"discountCode\": \"\",\n    \"items\": [\n        {\n            \"productId\": \"{{product_id}}\",\n            \"quantity\": 1\n        }\n    ]\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders"]
        }
      }
    },
    {
      "name": "4. Confirm WAITING_PAYMENT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "const status = response.orderStatus || response.status;",
              "if (status === 'PENDING') {",
              "    let r = pm.environment.get('retry_wp2') || 0; r++;",
              "    if (r < 5) { pm.environment.set('retry_wp2', r); setTimeout(function(){},2000); postman.setNextRequest('4. Confirm WAITING_PAYMENT'); }",
              "    else { pm.environment.unset('retry_wp2'); pm.test('WAITING_PAYMENT', function(){ pm.expect(status).to.equal('WAITING_PAYMENT'); }); }",
              "} else { pm.environment.unset('retry_wp2'); pm.test('WAITING_PAYMENT', function(){ pm.expect(status).to.equal('WAITING_PAYMENT'); }); }"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders/status/{{transaction_id}}",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders", "status", "{{transaction_id}}"]
        }
      }
    },
    {
      "name": "5. Create Payment (will never receive webhook)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.environment.set('payment_idempotency_key', pm.variables.replaceIn('{{$guid}}'));"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment created', function() { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const r = pm.response.json();",
              "pm.environment.set('payment_id', r.paymentId);",
              "pm.environment.set('payment_created_at', Date.now());",
              "console.log('┌─────────────────────────────────────');",
              "console.log('│ 💳 PAYMENT CREATED (will NOT send webhook)');",
              "console.log('│ paymentId:     ' + r.paymentId);",
              "console.log('│ transactionId: ' + r.transactionId);",
              "console.log('│ ⏱️ Waiting for payment expiry (30s) + scheduler (30s)...');",
              "console.log('└─────────────────────────────────────');"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Idempotency-Key", "value": "{{payment_idempotency_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"transactionId\": \"{{transaction_id}}\",\n    \"paymentMethod\": \"CREDIT_CARD\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/payments",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "payments"]
        }
      }
    },
    {
      "name": "6. Poll Payment Status (wait for FAILED)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status retrieved', function() { pm.response.to.have.status(200); });",
              "",
              "const response = pm.response.json();",
              "const status = response.paymentStatus || response.status;",
              "const elapsed = Math.round((Date.now() - pm.environment.get('payment_created_at')) / 1000);",
              "console.log('│ 💳 paymentStatus: ' + status + ' | elapsed: ' + elapsed + 's | paymentId: ' + pm.environment.get('payment_id'));",
              "",
              "if (status === 'FAILED') {",
              "    pm.environment.unset('retry_pay_exp');",
              "    pm.test('✅ Payment expired (FAILED)', function() {",
              "        pm.expect(status).to.equal('FAILED');",
              "    });",
              "    console.log('✅ Payment expired after ' + elapsed + 's');",
              "} else if (status === 'PENDING') {",
              "    let retryCount = pm.environment.get('retry_pay_exp') || 0;",
              "    retryCount++;",
              "    if (retryCount < 8) {",
              "        pm.environment.set('retry_pay_exp', retryCount);",
              "        console.log('⏳ Still PENDING, retry ' + retryCount + '/8');",
              "        postman.setNextRequest('6. Poll Payment Status (wait for FAILED)');",
              "    } else {",
              "        pm.environment.unset('retry_pay_exp');",
              "        pm.test('Payment should have expired', function() { pm.expect(status).to.equal('FAILED'); });",
              "    }",
              "} else {",
              "    let retryCount = pm.environment.get('retry_pay_exp') || 0;",
              "    retryCount++;",
              "    if (retryCount < 8) {",
              "        pm.environment.set('retry_pay_exp', retryCount);",
              "        console.log('⏳ Unexpected status ' + status + ', retry ' + retryCount + '/8');",
              "        postman.setNextRequest('6. Poll Payment Status (wait for FAILED)');",
              "    } else {",
              "        pm.environment.unset('retry_pay_exp');",
              "        pm.test('Payment should be FAILED after expiry', function() { pm.expect(status).to.equal('FAILED'); });",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/payments/status/{{payment_id}}",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "payments", "status", "{{payment_id}}"]
        }
      }
    },
    {
      "name": "7. Poll Order Status (wait for EXPIRED)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status retrieved', function() { pm.response.to.have.status(200); });",
              "",
              "const response = pm.response.json();",
              "const status = response.orderStatus || response.status;",
              "const elapsed = Math.round((Date.now() - pm.environment.get('payment_created_at')) / 1000);",
              "console.log('│ 📋 orderStatus: ' + status + ' | elapsed: ' + elapsed + 's | transactionId: ' + response.transactionId + ' | correlationId: ' + (response.correlationId || ''));",
              "",
              "if (status === 'EXPIRED') {",
              "    pm.environment.unset('retry_ord_exp');",
              "    pm.test('✅ Order EXPIRED after payment expiry', function() {",
              "        pm.expect(status).to.equal('EXPIRED');",
              "    });",
              "    console.log('┌─────────────────────────────────────');",
              "    console.log('│ 🎉 PAYMENT EXPIRY → ORDER EXPIRED');",
              "    console.log('│ transactionId: ' + response.transactionId);",
              "    console.log('│ paymentId:     ' + pm.environment.get('payment_id'));",
              "    console.log('│ elapsed:       ' + elapsed + 's');",
              "    console.log('└─────────────────────────────────────');",
              "} else if (status === 'WAITING_PAYMENT') {",
              "    let retryCount = pm.environment.get('retry_ord_exp') || 0;",
              "    retryCount++;",
              "    if (retryCount < 8) {",
              "        pm.environment.set('retry_ord_exp', retryCount);",
              "        console.log('⏳ Still WAITING_PAYMENT, retry ' + retryCount + '/8 (waiting for orchestrator scheduler)');",
              "        postman.setNextRequest('7. Poll Order Status (wait for EXPIRED)');",
              "    } else {",
              "        pm.environment.unset('retry_ord_exp');",
              "        pm.test('Order should have expired', function() { pm.expect(status).to.equal('EXPIRED'); });",
              "    }",
              "} else {",
              "    let retryCount = pm.environment.get('retry_ord_exp') || 0;",
              "    retryCount++;",
              "    if (retryCount < 8) {",
              "        pm.environment.set('retry_ord_exp', retryCount);",
              "        console.log('⏳ Unexpected order status ' + status + ', retry ' + retryCount + '/8');",
              "        postman.setNextRequest('7. Poll Order Status (wait for EXPIRED)');",
              "    } else {",
              "        pm.environment.unset('retry_ord_exp');",
              "        pm.test('Order should have expired', function() { pm.expect(status).to.equal('EXPIRED'); });",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders/status/{{transaction_id}}",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders", "status", "{{transaction_id}}"]
        }
      }
    }
  ]
}
