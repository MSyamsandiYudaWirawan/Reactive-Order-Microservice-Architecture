{
  "info": {
    "name": "E2E - Happy Path (Order Completed)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Full happy path: Register → Login → Create Order → Poll WAITING_PAYMENT → Create Payment → Webhook SUCCESS → Verify COMPLETED"
  },
  "variable": [],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('test_email') || pm.environment.get('test_email') === '') {",
          "    const uniqueEmail = 'e2e_' + Date.now() + '@testmail.com';",
          "    pm.environment.set('test_email', uniqueEmail);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Register User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registration successful', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "console.log('✅ Registered:', pm.environment.get('test_email'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"{{test_name}}\",\n    \"email\": \"{{test_email}}\",\n    \"phoneNumber\": \"+6281234567890\",\n    \"password\": \"{{test_password}}\",\n    \"confirmPassword\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/auth/register",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "auth", "register"]
        }
      }
    },
    {
      "name": "2. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login successful (200)', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "const response = pm.response.json();",
              "pm.environment.set('access_token', response.access_token);",
              "pm.environment.set('refresh_token', response.refresh_token);",
              "console.log('✅ Login OK — token saved');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"{{test_email}}\",\n    \"password\": \"{{test_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "3. Create Order",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('idempotency_key', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order created (201)', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const response = pm.response.json();",
              "pm.environment.set('transaction_id', response.transactionId);",
              "console.log('┌─────────────────────────────────────');",
              "console.log('│ 📦 ORDER CREATED');",
              "console.log('│ transactionId: ' + response.transactionId);",
              "console.log('│ idempotencyKey: ' + pm.environment.get('idempotency_key'));",
              "console.log('└─────────────────────────────────────');"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Idempotency-Key", "value": "{{idempotency_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"discountCode\": \"\",\n    \"items\": [\n        {\n            \"productId\": \"{{product_id}}\",\n            \"quantity\": 1\n        }\n    ]\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders"]
        }
      }
    },
    {
      "name": "4. Poll Order Status (wait for WAITING_PAYMENT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order status retrieved', function() { pm.response.to.have.status(200); });",
              "",
              "const response = pm.response.json();",
              "const status = response.orderStatus;",
              "console.log('│ 📋 status: ' + status + ' | transactionId: ' + response.transactionId + ' | correlationId: ' + response.correlationId);",
              "",
              "if (status === 'PENDING') {",
              "    let retryCount = pm.environment.get('retry_count_order') || 0;",
              "    retryCount++;",
              "    if (retryCount < 5) {",
              "        pm.environment.set('retry_count_order', retryCount);",
              "        console.log('│ ⏳ Still PENDING, retrying... (' + retryCount + '/5)');",
              "        postman.setNextRequest('4. Poll Order Status (wait for WAITING_PAYMENT)');",
              "    } else {",
              "        pm.environment.unset('retry_count_order');",
              "        pm.test('Order should be WAITING_PAYMENT', function() { pm.expect(status).to.equal('WAITING_PAYMENT'); });",
              "    }",
              "} else {",
              "    pm.environment.unset('retry_count_order');",
              "    pm.environment.set('correlation_id', response.correlationId);",
              "    pm.test('Order is WAITING_PAYMENT', function() { pm.expect(status).to.equal('WAITING_PAYMENT'); });",
              "    console.log('│ ✅ correlationId saved: ' + response.correlationId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders/status/{{transaction_id}}",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders", "status", "{{transaction_id}}"]
        }
      }
    },
    {
      "name": "5. Create Payment",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('payment_idempotency_key', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment created', function() { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "const response = pm.response.json();",
              "pm.environment.set('payment_id', response.paymentId);",
              "console.log('┌─────────────────────────────────────');",
              "console.log('│ 💳 PAYMENT CREATED');",
              "console.log('│ paymentId:     ' + response.paymentId);",
              "console.log('│ transactionId: ' + response.transactionId);",
              "console.log('│ amount:        ' + response.amount);",
              "console.log('│ method:        ' + response.paymentMethod);",
              "console.log('│ urlPayment:    ' + response.urlPayment);",
              "console.log('└─────────────────────────────────────');"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Idempotency-Key", "value": "{{payment_idempotency_key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"transactionId\": \"{{transaction_id}}\",\n    \"paymentMethod\": \"CREDIT_CARD\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/payments",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "payments"]
        }
      }
    },
    {
      "name": "6. Webhook - Payment Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Webhook accepted', function() { pm.expect(pm.response.code).to.be.oneOf([200, 202]); });",
              "console.log('│ 🔔 WEBHOOK sent: PAYMENT_SUCCESS | paymentId: ' + pm.environment.get('payment_id'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"paymentId\": \"{{payment_id}}\",\n    \"paymentStatus\": \"PAYMENT_SUCCESS\",\n    \"failureCode\": \"\",\n    \"failureMessage\": \"\"\n}"
        },
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/payments/webhook/callback",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "payments", "webhook", "callback"]
        }
      }
    },
    {
      "name": "7. Poll Order Status (wait for COMPLETED)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Order status retrieved', function() { pm.response.to.have.status(200); });",
              "",
              "const response = pm.response.json();",
              "const status = response.orderStatus;",
              "console.log('│ 📋 status: ' + status + ' | transactionId: ' + response.transactionId + ' | correlationId: ' + response.correlationId);",
              "",
              "if (status !== 'COMPLETED') {",
              "    let retryCount = pm.environment.get('retry_count_final') || 0;",
              "    retryCount++;",
              "    if (retryCount < 5) {",
              "        pm.environment.set('retry_count_final', retryCount);",
              "        console.log('│ ⏳ Not COMPLETED yet, retrying... (' + retryCount + '/5)');",
              "        postman.setNextRequest('7. Poll Order Status (wait for COMPLETED)');",
              "    } else {",
              "        pm.environment.unset('retry_count_final');",
              "        pm.test('Order should be COMPLETED', function() { pm.expect(status).to.equal('COMPLETED'); });",
              "    }",
              "} else {",
              "    pm.environment.unset('retry_count_final');",
              "    pm.test('✅ Order is COMPLETED', function() { pm.expect(status).to.equal('COMPLETED'); });",
              "    console.log('┌─────────────────────────────────────');",
              "    console.log('│ 🎉 HAPPY PATH COMPLETED');",
              "    console.log('│ transactionId: ' + response.transactionId);",
              "    console.log('│ correlationId: ' + response.correlationId);",
              "    console.log('│ paymentId:     ' + pm.environment.get('payment_id'));",
              "    console.log('│ finalStatus:   ' + status);",
              "    console.log('└─────────────────────────────────────');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/orders/status/{{transaction_id}}",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "orders", "status", "{{transaction_id}}"]
        }
      }
    },
    {
      "name": "8. Verify Payment Status (SUCCESS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment status retrieved', function() { pm.response.to.have.status(200); });",
              "const response = pm.response.json();",
              "pm.test('Payment is SUCCESS', function() { pm.expect(response.status).to.equal('SUCCESS'); });",
              "console.log('│ 💳 Payment status: ' + response.status + ' | transactionId: ' + response.transactionId);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}:{{gateway_port}}/api/v1/payments/status/{{payment_id}}",
          "host": ["{{base_url}}"],
          "port": "{{gateway_port}}",
          "path": ["api", "v1", "payments", "status", "{{payment_id}}"]
        }
      }
    }
  ]
}
